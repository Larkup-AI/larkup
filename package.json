{
  "name": "larkup",
  "version": "0.1.20",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "pnpm build && pnpm --filter \"./apps/web\" start",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "rag": "pnpm --filter @larkup/cli rag",
    "test:publish": "pnpm build && pnpm publish -r --dry-run --no-git-checks",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@turbo/gen": "^2.9.16",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@vercel/sdk": "^1.28.13",
    "uploadthing": "^7.7.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "read-yaml-file@1.1.0": "patches/read-yaml-file@1.1.0.patch",
      "tsup": "patches/tsup.patch"
    },
    "overrides": {
      "typescript": "^6.0.3",
      "undici": "^6.28.0",
      "body-parser": "^2.3.0",
      "esbuild": "^0.25.0",
      "minimatch": "^9.0.4",
      "tar": "^7.5.21",
      "glob": "^11.0.0",
      "ajv": "^8.16.0",
      "path-to-regexp": "^8.4.0",
      "postcss": "^8.4.38",
      "next": "^16.3.0",
      "effect": "^3.20.0",
      "fast-uri": "^3.1.5",
      "hono": "^4.12.34",
      "@hono/node-server": "^2.0.5",
      "ip-address": "^10.3.1",
      "js-yaml": "^4.3.0",
      "smol-toml": "^1.6.1",
      "@tootallnate/once": "^2.0.1",
      "sharp": "^0.35.0",
      "nanoid": "^3.3.17"
    }
  }
}
