# OAuth broker security. Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET="replace_with_a_long_random_secret"
# Comma-separated application origins that may receive OAuth callbacks.
LARKUP_ALLOWED_REDIRECT_ORIGINS="http://localhost:4567,https://larkup.de"
# Managed channel relay storage. Use a pooled Postgres URL from Vercel Postgres,
# Neon, Supabase, or another Postgres provider. The relay stores a workspace id,
# public tunnel URL, and a hash of a per-installation secret — never bot tokens.
DATABASE_URL=""

# Notion — https://www.notion.so/my-integrations
# Add https://<proxy-domain>/api/oauth/notion/callback under OAuth Domain & URIs.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Google — https://console.cloud.google.com/apis/credentials
# Add a callback for each enabled Google integration, for example:
# https://<proxy-domain>/api/oauth/google-drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Slack knowledge integration — https://api.slack.com/apps
# Read-only OAuth callback: https://<proxy-domain>/api/oauth/slack/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Slack managed Agent connection — create a separate Slack app for this surface.
# OAuth callback: https://<proxy-domain>/api/channels/slack/oauth/callback
# Events Request URL (set once by the Larkup operator):
# https://<proxy-domain>/api/channels/slack/events
# Bot scopes: chat:write, app_mentions:read, channels:history, groups:history,
# im:history, im:read. The signing secret stays only in this proxy.
# Naming convention for every managed channel: CONNECTION_<PROVIDER>_<CREDENTIAL>.
CONNECTION_SLACK_CLIENT_ID=""
CONNECTION_SLACK_CLIENT_SECRET=""
CONNECTION_SLACK_SIGNING_SECRET=""
# Migration only: if these values are absent, the managed Slack route falls back
# to the legacy SLACK_CLIENT_ID / SLACK_CLIENT_SECRET / SLACK_SIGNING_SECRET names.

# Discord managed Agent connection — one shared Discord application.
# OAuth callback: https://<proxy-domain>/api/channels/discord/oauth/callback
# Interactions Endpoint URL: https://<proxy-domain>/api/channels/discord/interactions
# Enable “Bot Require Code Grant”; the proxy creates /ask in each selected server.
CONNECTION_DISCORD_CLIENT_ID=""
CONNECTION_DISCORD_CLIENT_SECRET=""
CONNECTION_DISCORD_PUBLIC_KEY=""
CONNECTION_DISCORD_BOT_TOKEN=""

# GitHub — https://github.com/settings/developers
# Set https://<proxy-domain>/api/oauth/github/callback as the OAuth callback URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Atlassian — https://developer.atlassian.com/console/myapps/
# Add both /api/oauth/jira/callback and /api/oauth/confluence/callback.
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""

# Linear — https://linear.app/settings/api/applications/new
# Add https://<proxy-domain>/api/oauth/linear/callback and grant the read scope.
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""
