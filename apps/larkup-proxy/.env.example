# OAuth broker security. Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET="replace_with_a_long_random_secret"
# Comma-separated application origins that may receive OAuth callbacks.
LARKUP_ALLOWED_REDIRECT_ORIGINS="http://localhost:4567,https://larkup.de"

# Notion — https://www.notion.so/my-integrations
# Add https://<proxy-domain>/api/oauth/notion/callback under OAuth Domain & URIs.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Google — https://console.cloud.google.com/apis/credentials
# Add a callback for each enabled Google integration, for example:
# https://<proxy-domain>/api/oauth/google-drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Slack — https://api.slack.com/apps
# Add https://<proxy-domain>/api/oauth/slack/callback under OAuth & Permissions.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# GitHub — https://github.com/settings/developers
# Set https://<proxy-domain>/api/oauth/github/callback as the OAuth callback URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Atlassian — https://developer.atlassian.com/console/myapps/
# Add both /api/oauth/jira/callback and /api/oauth/confluence/callback.
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""

# Linear — https://linear.app/settings/api/applications/new
# Add https://<proxy-domain>/api/oauth/linear/callback and grant the read scope.
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""
