

# OAuth broker security. Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET="replace_with_a_long_random_secret"
# Comma-separated app origins that may receive OAuth callbacks.
LARKUP_ALLOWED_REDIRECT_ORIGINS="http://localhost:4567,https://larkup-proxy.larkup.de/"

# Notion — https://www.notion.so/my-integrations
# Create an internal integration. Under "OAuth Domain & URIs" add the callback:
# - https://larkup-proxy.larkup.de/api/oauth/notion/callback
# Copy the OAuth client ID and secret from the integration's "Secrets" tab.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Meet, Sheets, and Slides) — https://console.cloud.google.com/apis/credentials
# integration you enable:
# - https://larkup-proxy.larkup.de/api/oauth/google-analytics/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-calendar/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-docs/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-drive/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-maps/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-meet/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-sheets/callback
# - https://larkup-proxy.larkup.de/api/oauth/google-slides/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Slack — https://api.slack.com/apps
# Create a new app (from scratch). Under "OAuth & Permissions" add the redirect URL:
# - https://larkup-proxy.larkup.de/api/oauth/slack/callback
# Add Bot token scopes: channels:read, channels:history, groups:read, groups:history.
# Copy the Client ID and Client Secret from the "Basic Information" page.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# GitHub — https://github.com/settings/developers
# Create a new OAuth App. Set the "Authorization callback URL" to:
# - https://larkup-proxy.larkup.de/api/oauth/github/callback
# Copy the Client ID from the app page, then generate a Client Secret.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Atlassian / Confluence — https://developer.atlassian.com/console/myapps/
# Create an OAuth 2.0 (3LO) app. Under "Authorization" add the callback URL:
# - https://larkup-proxy.larkup.de/api/oauth/confluence/callback
# Enable scopes: read:confluence-content.all, read:confluence-space.summary, offline_access.
# Copy the Client ID and Secret from the app's "Settings" page.
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""
