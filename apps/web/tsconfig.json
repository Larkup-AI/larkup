{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../archive/assistant-capabilities-section.tsx",
    "../../archive/project-deploy-sheet.tsx",
    "../../archive/theme-switcher.tsx",
    "../../archive/page-header.tsx",
    "../../archive/simple-setup.tsx",
    "../../archive/tech-setup.tsx",
    "../../archive/firecrawl-notice.tsx",
    "../../archive/configure-form.tsx"
  ],
  "exclude": ["node_modules", "archive"]
}
