# URL of the Larkup OAuth proxy. The proxy holds the provider client secret;
# users authenticate with one Connect click and their returned token is saved locally.
NEXT_PUBLIC_INTEGRATIONS_PROXY_URL="http://localhost:3000/api/oauth"

# Optional: delivery for Video Intelligence "request more capacity" forms.
# These values stay server-side and must never be exposed with NEXT_PUBLIC_.
RESEND_API_KEY=""
LARKUP_USAGE_REQUEST_FROM="Larkup <usage@example.com>"
LARKUP_USAGE_REQUEST_TO="support@example.com"

# Managed channel OAuth uses the public Larkup proxy by default. No local
# setting or Slack secret is required. Set NEXT_PUBLIC_CHANNELS_PROXY_URL only
# when operating a self-hosted managed-channel proxy.
