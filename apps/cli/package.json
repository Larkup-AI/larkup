{
  "name": "@larkup/cli",
  "version": "0.3.21",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "larkup": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "larkup": "tsx src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^4.0.76",
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/gateway": "^4.0.136",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@clack/prompts": "^1.7.0",
    "@lancedb/lancedb": "^0.41.0",
    "@larkup/core": "workspace:*",
    "@larkup/marketplace": "workspace:*",
    "@larkup/vector-stores": "workspace:*",
    "@napi-rs/canvas": "1.1.0",
    "@pinecone-database/pinecone": "^9.0.0",
    "ai": "^7.0.163",
    "apache-arrow": "18.1.0",
    "chalk": "^6.0.0",
    "chromadb": "^3.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
