{
  "name": "@larkup/workspace-ui",
  "version": "0.1.0",
  "description": "Shared workspace presentation components for Larkup Local and Larkup Cloud",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./theme.css": "./src/theme.css"
  },
  "files": ["dist", "src/theme.css", "README.md"],
  "dependencies": { "clsx": "^2.1.1", "tailwind-merge": "^3.3.1", "class-variance-authority": "^0.7.1" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/workspace-ui.test.tsx"
  },
  "peerDependencies": { "react": ">=19" },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
  }
}
