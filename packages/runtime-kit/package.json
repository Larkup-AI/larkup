{
  "name": "@larkup/runtime-kit",
  "version": "0.3.0",
  "type": "module",
  "description": "Shared agent runtime browser assets and integration examples",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "type-check": "tsc --noEmit --allowJs --checkJs false --module nodenext --target es2022 src/index.js"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
