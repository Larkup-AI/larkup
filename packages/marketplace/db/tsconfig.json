{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true
  },
  "include": ["../src/db/**/*.ts"],
  "exclude": ["node_modules"]
}
