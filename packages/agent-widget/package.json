{
  "name": "@larkup/agent-widget",
  "version": "0.1.0",
  "description": "Embeddable browser chat widget for Larkup Agents — Shadow DOM isolated, public Agent ID only, no secrets",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/widget.js",
  "exports": {
    ".": "./dist/widget.js",
    "./dist/widget.js": "./dist/widget.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@larkup/agent-contracts": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
