# Copy to `.env.local` for a real controller, or leave unset to use built-in mocks.
# The dashboard NEVER reads benchmark.env and NEVER calls providers directly.

# Backend mode:
#   mock    -> serve in-memory contract fixtures (default when no controller URL)
#   proxy   -> forward approved /api/v1 ops to the real controller over SSH-forwarded loopback
#   offline -> read-only last-synced export; all writes disabled and labelled stale
DASHBOARD_MODE=mock

# Real controller (proxy mode only). Example SSH local-forward target from the contract.
# Never point this at the main Larkup API.
# BENCHMARK_CONTROLLER_URL=http://127.0.0.1:28890

# Controller auth token. Stays server-side only; never shipped to the browser.
# BENCHMARK_CONTROLLER_TOKEN=replace-me-local-controller-token

# Exact Origin(s) allowed to perform mutating requests against the BFF.
# Comma-separated. Defaults to the dashboard's own loopback origin on the chosen port.
# DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# Port is passed to Next via the start command, e.g. PORT=3100 npm run dev
PORT=3100
