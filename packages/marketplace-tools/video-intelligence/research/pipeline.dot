digraph VideoIntelligence {
  graph [rankdir=TB, newrank=true, bgcolor="white", fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.45, pad=0.2];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=10, color="#475569", margin="0.12,0.08"];
  edge [color="#64748b", fontname="Helvetica", fontsize=9, arrowsize=0.7];
  subgraph cluster_index {
    label="A. Canonical indexing runtime (local Docker / native / existing Modal service)";
    color="#cbd5e1";
    source [label="Source + initial goal\nVerified duration / authorized ranges"];
    plan [label="Bounded modality planner\nfast / balanced / thorough"];
    scout [label="Sparse chronological scout\nClassical change + optional OCR"];
    speech [label="Native captions or transcription\nOriginal language + timestamps"];
    refine [label="Refine plan from source signals\nExecutor clamps work"];
    sample [label="Scene / window planning\nAdaptive frame retention"];
    spool [label="Lossless temporary frame store\nOne active raw clip in RAM"];
    select [label="Chronological clip budget\nPriority + motion + OCR + speech"];
    visual [label="Bounded parallel vision waves\nEvidence-grounded continuity"];
    embed [label="Configured visual embeddings\nSkipped for live inspection"];
    notes [label="Timeline synthesis + source inventory\nCoverage + uncertainty + diagnostics"];
    index [label="Revision-scoped evidence store\nTranscript / OCR / notes / vectors"];
    source -> plan;
    plan -> scout; plan -> speech;
    scout -> refine; speech -> refine;
    refine -> sample -> spool -> select;
    select -> visual; select -> embed;
    speech -> notes; visual -> notes;
    notes -> index; embed -> index;
  }
  subgraph cluster_chat {
    label="B. Shared chat tool and host adapters";
    color="#cbd5e1";
    question [label="User question\nTyped investigation directive"];
    memory [label="Revision-scoped answer memory"];
    retrieve [label="Focused retrieval / temporal trace /\nchronological full-source paging"];
    assess [shape=diamond, label="Evidence\nsufficient?"];
    inspect [label="Authorized bounded re-watch\nSeek range; bypass global synthesis"];
    answer [label="Grounded answer + timestamps\nPaged full-content output / artifacts"];
    question -> memory -> retrieve -> assess;
    assess -> answer [label="yes"];
    assess -> inspect [label="no; within deadline"];
    inspect -> retrieve [label="append evidence revision"];
    answer -> memory [label="supported answers only", constraint=false];
  }
  { rank=same; source; question; }
  index -> retrieve [constraint=false];
}
